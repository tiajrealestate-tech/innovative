{
  "manifest_version": 3,
  "name": "HyperReports AI (beta)",
  "version": "1.0.0",
  "description": "Builds your inspection report for you — checks the boxes and places your write-ups, in your words. Works with Spectora.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.spectora.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://innovative-eight-rosy.vercel.app/*",
        "https://hyperreports.ai/*",
        "https://www.hyperreports.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
