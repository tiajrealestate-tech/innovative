{
  "manifest_version": 3,
  "name": "HyperReports AI (beta)",
  "version": "1.3.3",
  "description": "Builds your inspection report for you \u2014 checks the boxes and places your write-ups, in your words. Works with Spectora.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.spectora.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://innovative-eight-rosy.vercel.app/*",
        "https://hyperreports.ai/*",
        "https://www.hyperreports.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}