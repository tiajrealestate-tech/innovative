# ---------------------------------------------------------------------------
# Copy this file to ".env.local" for local development, and set these same
# values in your Vercel project settings for the deployed app.
# NEVER commit your real keys. ".env.local" is already git-ignored.
# ---------------------------------------------------------------------------

# 1) Claude (Anthropic) API key — powers the AI that structures the findings.
#    Get it from https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Deepgram API key — powers speech-to-text (turns the voice memo into text).
#    Get it from https://console.deepgram.com  (API Keys)
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3) Shared password to open the app (so random visitors can't spend your API
#    credits). Pick anything you like.
APP_PASSWORD=change-me-to-something-only-you-know

# 4) Vercel Blob storage token — lets the browser upload large voice memos.
#    On Vercel: create a Blob store (Storage tab) and this is filled in for you
#    automatically. For local dev, copy it from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
